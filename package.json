{
  "name": "dream-piggy-bank",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"tsx watch server/index.ts\" \"vite --host 127.0.0.1\"",
    "build": "npm run typecheck && vite build",
    "start": "tsx server/index.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.server.json",
    "lint": "eslint .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "format": "prettier --write .",
    "check:pma": "tsx scripts/check-pma.ts",
    "check:forex": "tsx scripts/check-forex.ts",
    "check:startup": "vitest run tests/startup-performance.test.ts",
    "check:savings": "tsx scripts/check-savings-schema.ts",
    "check:auth-build": "tsx scripts/check-auth-build.ts",
    "check:deployment": "tsx scripts/check-deployment.ts",
    "check:secrets": "tsx scripts/audit-secrets.ts",
    "check:database": "tsx scripts/check-database-readiness.ts",
    "start:preview": "tsx scripts/preview-production.ts",
    "test:production": "playwright test --config playwright.production.config.ts",
    "test:postgres": "tsx scripts/test-backend-postgres.ts",
    "export:legacy": "tsx scripts/export-legacy-storage.ts",
    "import:legacy": "tsx scripts/import-legacy-storage.ts",
    "check:node-function": "node scripts/check-node-function.mjs"
  },
  "dependencies": {
    "@auth0/auth0-react": "^2.28.2",
    "@google/genai": "^2.32.0",
    "@js-temporal/polyfill": "^0.5.1",
    "@supabase/supabase-js": "^2.118.0",
    "@tailwindcss/vite": "^4.1.0",
    "cookie-parser": "^1.4.7",
    "dotenv": "^17.2.0",
    "express": "^5.1.0",
    "express-rate-limit": "^8.1.0",
    "helmet": "^8.1.0",
    "jose": "^6.2.13",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwindcss": "^4.1.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.11",
    "@eslint/js": "^9.0.0",
    "@playwright/test": "^1.55.0",
    "@testing-library/react": "^16.0.0",
    "@types/cookie-parser": "^1.4.8",
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "concurrently": "^9.0.0",
    "embedded-postgres": "^18.6.0-beta.19",
    "eslint": "^9.0.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^16.0.0",
    "jsdom": "^26.0.0",
    "pg": "^8.23.1",
    "prettier": "^3.9.10",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.0.0",
    "vite": "^7.0.0",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": "24.x"
  }
}
