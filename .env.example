PORT=3001
APP_ORIGIN=http://127.0.0.1:5173

DATABASE_PATH=data/walletwise.db
# Set firestore for Vercel; sqlite is the local default.
STORAGE=sqlite
# JSON service-account credential. Server only; never use a VITE_ prefix.
FIREBASE_SERVICE_ACCOUNT=
FIREBASE_WEB_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
CRON_SECRET=

# Auth0: public identifiers, delivered via /api/config. No frontend secrets.
# .env.auth0 is an ignored local convenience file; deployment uses server env.
AUTH0_ENABLED=false
AUTH0_DOMAIN=your-tenant.auth0.com
AUTH0_CLIENT_ID=your-public-client-id
AUTH0_DATABASE_CONNECTION=Username-Password-Authentication
# Enable the Auth0 social connection named paypal-sandbox for this application.
# PayPal credentials belong only in that Auth0 connection, never here for login.

# Supabase Third-Party Auth (Auth0); the secret key is server-side only.
SUPABASE_ENABLED=false
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Local Developer Demo Mode and development-only public market reads
# Both are disabled in production/Vercel.
VITE_ENABLE_DEMO_MODE=false

# In-memory private frontend state freshness (milliseconds; capped at 10 seconds).
VITE_STATE_STALE_MS=1500
# Provider observations: indicative, not continuous. Staleness cannot be shorter than cache TTL.
RATE_CACHE_TTL_MS=21600000
RATE_STALE_MS=129600000
# Account-specific cached AI explanations; current report calculations are always rebuilt.
AI_CACHE_TTL_MS=900000
# Shared Gemini quota and concurrent request leases, enforced through the server store.
GEMINI_REQUESTS_PER_MINUTE=30
GEMINI_MAX_CONCURRENT=3
# Server-side limits per 60-second window. Reads and writes use verified user IDs.
# Entry uses socket IP locally and Vercel's platform-supplied IP on Vercel.
RATE_LIMIT_ENTRY=120
RATE_LIMIT_READ=120
RATE_LIMIT_AI=5
RATE_LIMIT_REFRESH=3
RATE_LIMIT_PAYMENT=5
RATE_LIMIT_PROFILE=20
RATE_LIMIT_FINANCIAL=30

# Optional Twelve Data Forex feed (server-only key). Legacy PMA stays active unless selected.
# Set to twelve after obtaining pair entitlements and the required display/storage license.
MARKET_DATA_PROVIDER=pma
TWELVE_DATA_API_KEY=
# Default: two credits per 5-minute cycle = at most 576 quote credits per 24 hours.
# For a suitably licensed plan, 60000 enables a 1-minute provider polling interval.
FOREX_POLL_MS=300000
FOREX_STALE_MS=180000
# Effective freshness threshold is at least twice FOREX_POLL_MS.
FOREX_MAX_SKEW_MS=120000
TWELVE_DATA_MINUTE_CREDITS=8
TWELVE_DATA_DAILY_CREDITS=800

# Development-only public market reads per source IP per minute
RATE_LIMIT_PUBLIC_MARKET=30
# Provider directory must support these legs; either configured inverse is also accepted.
FOREX_ILS_SYMBOL=USD/ILS
FOREX_JOD_SYMBOL=USD/JOD
